+def _source_text_is_vertical(render_info: Optional[Dict[str, Any]]) -> bool:
+    source_text_bbox = render_info.get("text_bbox") if render_info else None
+    if not source_text_bbox or len(source_text_bbox) != 4:
+        return False
+    source_text_width = max(0, source_text_bbox[2] - source_text_bbox[0])
+    source_text_height = max(0, source_text_bbox[3] - source_text_bbox[1])
+    return source_text_width > 0 and source_text_height >= source_text_width * 1.15
