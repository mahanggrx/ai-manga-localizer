+def _rendered_text_mask(
+    base_image: Image.Image,
+    rendered_image: Image.Image,
+    bbox: Tuple[int, int, int, int],
+) -> np.ndarray:
+    """Return pixels changed by one isolated text render."""
+    if base_image.size != rendered_image.size:
+        raise RenderingError("Rendered text layer size changed unexpectedly")
+    width, height = base_image.size
+    x1 = max(0, min(width, int(math.floor(bbox[0]))))
+    y1 = max(0, min(height, int(math.floor(bbox[1]))))
+    x2 = max(x1, min(width, int(math.ceil(bbox[2]))))
+    y2 = max(y1, min(height, int(math.ceil(bbox[3]))))
+    mask = np.zeros((height, width), dtype=np.uint8)
+    if x2 <= x1 or y2 <= y1:
+        return mask
+    base_crop = np.asarray(base_image.crop((x1, y1, x2, y2)).convert("RGBA"))
+    rendered_crop = np.asarray(
+        rendered_image.crop((x1, y1, x2, y2)).convert("RGBA")
+    )
+    changed = np.any(cv2.absdiff(rendered_crop, base_crop) > 1, axis=2)
+    mask[y1:y2, x1:x2] = changed.astype(np.uint8)
+    return mask
+
