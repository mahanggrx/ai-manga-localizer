+def _bbox_key(value: Any) -> Optional[Tuple[int, int, int, int]]:
+    try:
+        box = tuple(int(round(float(item))) for item in value)
+    except (TypeError, ValueError):
+        return None
+    return box if len(box) == 4 else None
+
