+def _text_collision_pixels(candidate: np.ndarray, occupied: np.ndarray) -> int:
+    """Count collisions, including a small readability margin around glyphs."""
+    if candidate.shape != occupied.shape:
+        raise RenderingError("Rendered text occupancy shape mismatch")
+    kernel = np.ones((3, 3), dtype=np.uint8)
+    expanded_candidate = cv2.dilate(candidate, kernel, iterations=1)
+    expanded_occupied = cv2.dilate(occupied, kernel, iterations=1)
+    return int(np.count_nonzero(expanded_candidate & expanded_occupied))
+
+
