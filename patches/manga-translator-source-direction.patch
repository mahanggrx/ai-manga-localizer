+def _mask_overlap_share(first: Any, second: Any) -> float:
+    try:
+        first_mask = np.asarray(first) > 0
+        second_mask = np.asarray(second) > 0
+    except Exception:
+        return 0.0
+    if first_mask.shape != second_mask.shape or first_mask.ndim != 2:
+        return 0.0
+    smaller = min(int(np.count_nonzero(first_mask)), int(np.count_nonzero(second_mask)))
+    if smaller <= 0:
+        return 0.0
+    return float(np.count_nonzero(first_mask & second_mask)) / smaller
+
