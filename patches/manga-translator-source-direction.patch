+def _shared_group_font_size(
+    group_items: List[Tuple[Dict[str, Any], str]],
+    page_render_base: Image.Image,
+    render_info_map: Dict[Tuple[int, int, int, int], Dict[str, Any]],
+    render_config: RenderingConfig,
+    font_dir: str,
+    verbose: bool,
+) -> Optional[int]:
+    """Find a common fitted size that also separates all group text masks."""
+    fitted_sizes: List[int] = []
+    render_members: List[
+        Tuple[
+            str,
+            Tuple[int, int, int, int],
+            Optional[np.ndarray],
+            Tuple[int, int, int],
+            Optional[Tuple[int, int, int]],
+            bool,
+        ]
+    ] = []
+    for group_index, (group_bubble, group_text) in enumerate(group_items):
+        if not group_text or group_bubble.get("is_outside_text", False):
+            continue
+        group_bbox = _bbox_key(group_bubble.get("bbox", ()))
+        if group_bbox is None:
+            continue
+        group_info = group_bubble.get("_render_info") or render_info_map.get(
+            group_bbox
+        )
+        group_mask = group_info.get("mask") if group_info else None
+        group_color = (
+            group_info.get("color", (255, 255, 255))
+            if group_info
+            else (255, 255, 255)
+        )
+        group_text_color = None
+        if group_info and group_info.get("text_color_bgr"):
+            bgr = group_info["text_color_bgr"]
+            group_text_color = (bgr[2], bgr[1], bgr[0])
+        try:
+            probe = render_text_skia(
+                pil_image=page_render_base,
+                text=group_text,
+                bbox=group_bbox,
+                font_dir=font_dir,
+                cleaned_mask=group_mask,
+                bubble_color_bgr=group_color,
+                config=render_config,
+                verbose=verbose,
+                bubble_id=f"shared-{group_index}",
+                rotation_deg=0.0,
+                vertical_stack=_source_text_is_vertical(group_info),
+                text_color_rgb=group_text_color,
+                raise_on_safe_error=False,
+                layout_only=True,
+            )
+        except Exception:
+            continue
+        font_size = probe.info.get("font_size")
+        if isinstance(font_size, (int, float)) and font_size > 0:
+            fitted_sizes.append(int(round(font_size)))
+            render_members.append(
+                (
+                    group_text,
+                    group_bbox,
+                    group_mask,
+                    group_color,
+                    group_text_color,
+                    _source_text_is_vertical(group_info),
+                )
+            )
+
+    if not fitted_sizes or not render_members:
+        return None
+
+    common_font_size = min(fitted_sizes)
+
+    def _group_collision_pixels(font_size: int) -> Optional[int]:
+        occupied = np.zeros(
+            (page_render_base.height, page_render_base.width), dtype=np.uint8
+        )
+        total_collision = 0
+        for member_index, (
+            member_text,
+            member_bbox,
+            member_mask,
+            member_color,
+            member_text_color,
+            member_vertical_stack,
+        ) in enumerate(render_members):
+            size_multiplier = (
+                render_config.vertical_font_size_mul
+                if member_vertical_stack
+                else 1.0
+            )
+            member_size = max(
+                render_config.min_font_size,
+                min(
+                    render_config.max_font_size,
+                    int(round(font_size / max(size_multiplier, 0.1))),
+                ),
+            )
+            member_config = replace(
+                render_config,
+                min_font_size=member_size,
+                max_font_size=member_size,
+            )
+            try:
+                isolated_layer = render_text_skia(
+                    pil_image=page_render_base,
+                    text=member_text,
+                    bbox=member_bbox,
+                    font_dir=font_dir,
+                    cleaned_mask=member_mask,
+                    bubble_color_bgr=member_color,
+                    config=member_config,
+                    verbose=verbose,
+                    bubble_id=f"shared-collision-{member_index}",
+                    rotation_deg=0.0,
+                    vertical_stack=member_vertical_stack,
+                    text_color_rgb=member_text_color,
+                    raise_on_safe_error=False,
+                )
+            except Exception:
+                return None
+            member_occupancy = _rendered_text_mask(
+                page_render_base, isolated_layer, member_bbox
+            )
+            total_collision += _text_collision_pixels(member_occupancy, occupied)
+            occupied |= member_occupancy
+        return total_collision
+
+    best_font_size = common_font_size
+    best_collision: Optional[int] = None
+    seen_sizes = set()
+    for collision_scale in (1.0, *TEXT_COLLISION_RETRY_SCALES):
+        candidate_font_size = max(1, int(round(common_font_size * collision_scale)))
+        if candidate_font_size in seen_sizes:
+            continue
+        seen_sizes.add(candidate_font_size)
+        collision_pixels = _group_collision_pixels(candidate_font_size)
+        if collision_pixels is None:
+            continue
+        if collision_pixels == 0:
+            if candidate_font_size != common_font_size:
+                log_message(
+                    "Resolved conjoined text collision by shrinking the whole group",
+                    verbose=verbose,
+                    always_print=True,
+                )
+            return candidate_font_size
+        if best_collision is None or collision_pixels < best_collision:
+            best_collision = collision_pixels
+            best_font_size = candidate_font_size
+    return best_font_size


