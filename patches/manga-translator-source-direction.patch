+def _merge_shared_bubble_render_items(
+    bubbles: List[Dict[str, Any]],
+    translations: List[str],
+    render_info_map: Dict[Tuple[int, int, int, int], Dict[str, Any]],
+) -> List[Tuple[Dict[str, Any], str]]:
+    """Merge text regions whose detections refer to the same speech bubble."""
+    parents = list(range(len(bubbles)))
+
+    def find(index: int) -> int:
+        while parents[index] != index:
+            parents[index] = parents[parents[index]]
+            index = parents[index]
+        return index
+
+    def union(first: int, second: int) -> None:
+        first_root = find(first)
+        second_root = find(second)
+        if first_root != second_root:
+            parents[second_root] = first_roo
+
+    for first_index, first_bubble in enumerate(bubbles):
+        if first_bubble.get("is_outside_text", False):
+            continue
+        first_box = _bbox_key(first_bubble.get("bbox", ()))
+        first_info = render_info_map.get(first_box)
+        if first_box is None or not first_info:
+            continue
+        for second_index in range(first_index + 1, len(bubbles)):
+            second_bubble = bubbles[second_index]
+            if second_bubble.get("is_outside_text", False):
+                continue
+            second_box = _bbox_key(second_bubble.get("bbox", ()))
+            second_info = render_info_map.get(second_box)
+            if second_box is None or not second_info:
+                continue
+            first_neighbors = {
+                neighbor_box
+                for neighbor_box in (
+                    _bbox_key(value)
+                    for value in first_bubble.get("conjoined_neighbor_bboxes") or ()
+                )
+                if neighbor_box is not None
+            }
+            second_neighbors = {
+                neighbor_box
+                for neighbor_box in (
+                    _bbox_key(value)
+                    for value in second_bubble.get("conjoined_neighbor_bboxes") or ()
+                )
+                if neighbor_box is not None
+            }
+            explicit_conjoined_match = (
+                second_box in first_neighbors or first_box in second_neighbors
+            )
+            cleaned_masks_match = (
+                _mask_overlap_share(first_info.get("mask"), second_info.get("mask"))
+                >= 0.50
+            )
+            base_masks_overlap = (
+                _mask_overlap_share(
+                    first_info.get("base_mask"), second_info.get("base_mask")
+                )
+                > 0.0
+            )
+            if explicit_conjoined_match or cleaned_masks_match or base_masks_overlap:
+                union(first_index, second_index)
+
+    grouped: "OrderedDict[int, List[int]]" = OrderedDict()
+    for index in range(len(bubbles)):
+        grouped.setdefault(find(index), []).append(index)
+
+    render_items: List[Tuple[Dict[str, Any], str]] = []
+    shared_group_number = 0
+    for indices in grouped.values():
+        if len(indices) == 1:
+            index = indices[0]
+            render_items.append((bubbles[index], translations[index]))
+            continue
+
+        # Keep each detected text block in its own geometry.  A conjoined
+        # relation is a typography/collision group, not permission to inven
+        # a rectangular union bubble: the union can extend into page artwork.
+        group_id = f"conjoined-{shared_group_number}"
+        shared_group_number += 1
+        for index in indices:
+            shared_bubble = dict(bubbles[index])
+            shared_bubble["_shared_group_id"] = group_id
+            shared_bubble["_shared_group_size"] = len(indices)
+            render_items.append((shared_bubble, translations[index]))
+    return render_items
+
