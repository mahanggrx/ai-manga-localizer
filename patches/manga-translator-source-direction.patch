+def _filter_caption_like_regions(pil_image: Image.Image, outside_text_results):
+    """Keep medium-sized text blocks surrounded by clean light page space."""
+    image_gray = np.asarray(pil_image.convert("L"))
+    img_h, img_w = image_gray.shape
+    image_area = float(img_w * img_h)
+    caption_results = []
+
+    for bbox, conf in outside_text_results:
+        raw_x1, raw_y1, raw_x2, raw_y2 = [int(c) for c in bbox]
+        x1 = max(0, min(img_w, raw_x1))
+        y1 = max(0, min(img_h, raw_y1))
+        x2 = max(0, min(img_w, raw_x2))
+        y2 = max(0, min(img_h, raw_y2))
+        width = max(0, x2 - x1)
+        height = max(0, y2 - y1)
+        area_ratio = (width * height) / max(1.0, image_area)
+        if not OSB_CAPTION_MIN_AREA_RATIO <= area_ratio <= OSB_CAPTION_MAX_AREA_RATIO:
+            continue
+
+        padding = max(8, int(min(width, height) * 0.25))
+        ex1 = max(0, x1 - padding)
+        ey1 = max(0, y1 - padding)
+        ex2 = min(img_w, x2 + padding)
+        ey2 = min(img_h, y2 + padding)
+        ring = image_gray[ey1:ey2, ex1:ex2]
+        ring_mask = np.ones(ring.shape, dtype=bool)
+        ring_mask[y1 - ey1 : y2 - ey1, x1 - ex1 : x2 - ex1] = False
+        ring_pixels = ring[ring_mask]
+        if ring_pixels.size == 0:
+            continue
+        light_ratio = float(np.mean(ring_pixels >= 235))
+        if light_ratio >= OSB_CAPTION_MIN_LIGHT_RING_RATIO:
+            caption_results.append((bbox, conf))
+
+    return caption_results
+
+
+def _caption_bbox_is_vertical(bbox) -> bool:
+    x1, y1, x2, y2 = bbox
+    return (y2 - y1) >= (x2 - x1) * 1.2


