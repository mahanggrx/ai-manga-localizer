{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter-manifest.schema.json",
  "title": "ChapterManifest",
  "type": "object",
  "required": ["schemaVersion", "chapterId", "title", "sourceLanguage", "targetLanguage", "createdAt", "sourceFiles", "regions", "glossary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chapterId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sourceLanguage": { "const": "ja" },
    "targetLanguage": { "const": "zh-CN" },
    "createdAt": { "type": "string", "minLength": 1 },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pageId", "fileName", "sha256"],
        "properties": {
          "pageId": { "type": "string", "minLength": 1 },
          "fileName": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "regions": { "type": "array" },
    "glossary": { "type": "object" }
  },
  "additionalProperties": false
}

