{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-lock.schema.json",
  "title": "ModelLock",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "benchmarkId", "koharuVersion", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "koharuVersion": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "version", "sha256", "license", "role", "selected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "quantization": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "localPath": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["ocr", "translation", "review", "inpainting"] },
          "selected": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

