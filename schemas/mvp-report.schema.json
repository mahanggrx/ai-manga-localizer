{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/mvp-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "startedAt", "completedAt", "inputKind", "outputImages", "failedImages", "outsideTextMode", "engine"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "status": { "enum": ["completed", "partial", "failed"] },
    "startedAt": { "type": "string", "minLength": 1 },
    "completedAt": { "type": "string", "minLength": 1 },
    "inputKind": { "enum": ["directory", "zip", "cbz", "image", "unknown"] },
    "outputImages": { "type": "integer", "minimum": 0 },
    "failedImages": { "type": "integer", "minimum": 0 },
    "outsideTextMode": { "enum": ["disabled", "text-free-opencv"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline", "translator", "ocr"],
      "properties": {
        "pipeline": { "const": "MangaTranslator" },
        "translator": { "const": "Hy-MT2-7B-Q4_K_M" },
        "ocr": { "const": "manga-ocr" }
      }
    },
    "cbz": { "const": "translated.cbz" },
    "errorCode": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["completed", "partial"] } } },
      "then": { "required": ["cbz"] }
    }
  ]
}
