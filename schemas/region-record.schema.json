{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region-record.schema.json",
  "title": "RegionRecord",
  "type": "object",
  "required": ["schemaVersion", "id", "pageId", "order", "role", "policy", "sourceText", "ocrCandidates", "translationCandidates", "qaFlags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "pageId": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "role": { "type": "string", "enum": ["dialogue", "caption", "sfx", "unknown"] },
    "policy": { "type": "string", "enum": ["replace", "preserve-with-annotation"] },
    "sourceText": { "type": "string" },
    "translatedText": { "type": "string" },
    "bbox": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "insideBubble": { "type": "boolean" },
    "bubbleInstanceId": { "type": "string", "minLength": 1 },
    "geometrySource": { "type": "string", "enum": ["line-polygons", "bbox"] },
    "roleConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "roleProvenance": { "type": "string", "enum": ["native", "bubble-mask", "insufficient-evidence"] },
    "ocrConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ocrCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["engine", "text", "selected", "selectionReason"],
        "properties": {
          "engine": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "selected": { "type": "boolean" },
          "selectionReason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "translationCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "text", "selected", "selectionReason", "route"],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "selected": { "type": "boolean" },
          "selectionReason": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "enum": ["local", "cloud"] }
        },
        "additionalProperties": false
      }
    },
    "qaFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "retryable"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "regionId": { "type": "string", "minLength": 1 },
          "pageId": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "retryable": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
