{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow-cache-manifest.schema.json",
  "title": "ShadowCacheManifest",
  "type": "object",
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/safeRelativePath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "hardlinkTo": { "$ref": "#/$defs/safeRelativePath" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))(?!.*:).+$"
    }
  }
}
